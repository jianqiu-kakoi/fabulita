{
  "id": "watashi-no-ichinichi",
  "title": "わたしの一日",
  "title_note": "我的一天",
  "status": "accepted",
  "sentences": [
    { "text": "わたしは学生です。", "trans": "我是学生。" },
    { "text": "朝、パンを食べます。", "trans": "早上我吃面包。" },
    { "text": "コーヒーも飲みます。", "trans": "也喝咖啡。" },
    { "text": "電車で学校へ行きます。", "trans": "我坐电车去学校。" },
    { "text": "学校で先生と友だちに会います。", "trans": "在学校见到老师和朋友。" },
    { "text": "夜、家で本を読みます。", "trans": "晚上在家读书。" }
  ],
  "vocab_used": ["学生", "朝", "パン", "コーヒー", "電車", "学校", "先生", "友だち", "夜", "家", "本"],
  "glossary": {},
  "grammar": [
    ["〜は〜です", "……是……：わたしは学生です。"],
    ["を + 动词", "宾语标记：パンを食べます 吃面包。"],
    ["で", "两个用法：地点（学校で）、手段（電車で）。"],
    ["へ + 行きます", "表示去的方向：学校へ行きます。"]
  ]
}
