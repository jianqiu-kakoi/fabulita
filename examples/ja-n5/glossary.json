{
  "わたし": ["我"],
  "は": ["主题助词", "标记句子主题，读作 wa"],
  "です": ["是（敬体）"],
  "を": ["宾语助词", "标记动作对象，读作 o"],
  "も": ["也"],
  "で": ["助词：在（地点）/ 用（手段）", "学校で 在学校；電車で 坐电车"],
  "へ": ["方向助词：往、去", "读作 e"],
  "と": ["和；跟", "友だちと 和朋友"],
  "に": ["助词：向、对；在（时间点）"],
  "の": ["……的"],
  "食べます": ["吃", "← 食べる（たべる）"],
  "飲みます": ["喝", "← 飲む（のむ）"],
  "行きます": ["去", "← 行く（いく）"],
  "会います": ["见面", "← 会う（あう）"],
  "読みます": ["读", "← 読む（よむ）"],
  "聞きます": ["听", "← 聞く（きく）"],
  "見ます": ["看", "← 見る（みる）"]
}
