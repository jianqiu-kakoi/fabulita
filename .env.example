# Local deployment connection. Copy to .env and keep the real values private.
VPS_HOST=
VPS_SSH_PORT=22
VPS_USER=deploy
VPS_SSH_PASSWORD=

# Optional OpenAI-compatible scoring provider. Leave blank to disable it.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_MS=12000
LLM_RATE_LIMIT_PER_MINUTE=10
