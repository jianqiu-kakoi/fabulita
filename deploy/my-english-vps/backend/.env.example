# Node listens only behind the same-host reverse proxy.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=/var/lib/my-english/my-english.sqlite

# Exact browser origins, comma-separated, with no path or trailing slash.
ALLOWED_ORIGINS=https://english.chyuopen.com
COOKIE_NAME=__Host-my_english_session
SESSION_TTL_DAYS=30

# Registration is fail-closed. Set true only after the current privacy notice
# and consent UI are live. The required consent version is server-defined.
REGISTRATION_ENABLED=false

# Current scrypt uses N=2^17, r=8, p=1 (about 128 MiB per active hash).
# The backend clamps concurrency to at most 2 on this VPS profile.
PASSWORD_SCRYPT_CONCURRENCY=2
PASSWORD_SCRYPT_QUEUE_LIMIT=8

# Authentication abuse controls. Client IP comes from a sanitized
# X-Forwarded-For header only when the direct peer is loopback.
AUTH_REGISTER_IP_LIMIT_PER_HOUR=5
AUTH_REGISTER_EMAIL_LIMIT_PER_HOUR=3
AUTH_LOGIN_IP_LIMIT_PER_15_MINUTES=30
AUTH_LOGIN_EMAIL_LIMIT_PER_15_MINUTES=10
ACTION_RATE_LIMIT_PER_MINUTE=240

# Per-account durable learning-data limits.
MAX_EVENTS_PER_USER=20000
MAX_EVENT_BYTES_PER_USER=67108864
MAX_SCOPES_PER_USER=20
MAX_CHECKPOINT_BYTES_PER_USER=8388608

# Server-only OpenAI-compatible grading provider. Leave all three blank to
# keep LLM grading disabled.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_MS=4000
LLM_RATE_LIMIT_PER_MINUTE=10

# Global cost/capacity circuit breakers across every account.
LLM_GLOBAL_RATE_LIMIT_PER_MINUTE=30
LLM_GLOBAL_RATE_LIMIT_PER_DAY=500
LLM_MAX_CONCURRENCY=4
