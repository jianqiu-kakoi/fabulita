[Unit]
Description=My English API
Documentation=file:/opt/chyuopen/my-english/current/README.md
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=myenglish
Group=myenglish
WorkingDirectory=/opt/chyuopen/my-english/current/server
EnvironmentFile=/etc/my-english/my-english.env
ExecStart=/usr/bin/node dist/server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077

StateDirectory=my-english
StateDirectoryMode=0700
ReadWritePaths=/var/lib/my-english
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
LimitNOFILE=65536

StandardOutput=journal
StandardError=journal
SyslogIdentifier=my-english

[Install]
WantedBy=multi-user.target
