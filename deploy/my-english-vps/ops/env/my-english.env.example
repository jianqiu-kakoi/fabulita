# Installed as /etc/my-english/my-english.env with mode 0640.
# Keep this file out of chat, tickets, and Git after adding real values.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=/var/lib/my-english/my-english.sqlite
ALLOWED_ORIGINS=https://english.chyuopen.com
COOKIE_NAME=__Host-my_english_session
SESSION_TTL_DAYS=30
REGISTRATION_ENABLED=false
EMAIL_VERIFICATION_ENABLED=false
EMAIL_VERIFICATION_SECRET=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_MAX_CONCURRENCY=2
PASSWORD_SCRYPT_CONCURRENCY=2
PASSWORD_SCRYPT_QUEUE_LIMIT=8

# Abuse and storage limits sized for the initial VPS.
AUTH_REGISTER_IP_LIMIT_PER_HOUR=5
AUTH_REGISTER_EMAIL_LIMIT_PER_HOUR=3
AUTH_VERIFICATION_IP_LIMIT_PER_HOUR=5
AUTH_VERIFICATION_EMAIL_LIMIT_PER_HOUR=3
AUTH_VERIFICATION_GLOBAL_LIMIT_PER_MINUTE=10
AUTH_VERIFICATION_GLOBAL_LIMIT_PER_HOUR=100
AUTH_VERIFICATION_GLOBAL_LIMIT_PER_DAY=500
AUTH_LOGIN_IP_LIMIT_PER_15_MINUTES=30
AUTH_LOGIN_EMAIL_LIMIT_PER_15_MINUTES=10
ACTION_RATE_LIMIT_PER_MINUTE=120
MAX_EVENTS_PER_USER=10000
MAX_EVENT_BYTES_PER_USER=16777216
MAX_SCOPES_PER_USER=10
MAX_CHECKPOINT_BYTES_PER_USER=4194304

# OpenAI-compatible scoring provider. Leave all three blank to disable LLM scoring.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=12000
LLM_RATE_LIMIT_PER_MINUTE=10
LLM_GLOBAL_RATE_LIMIT_PER_MINUTE=30
LLM_GLOBAL_RATE_LIMIT_PER_DAY=500
LLM_MAX_CONCURRENCY=2
