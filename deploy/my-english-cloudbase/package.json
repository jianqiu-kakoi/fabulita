{
  "name": "my-english-cloudbase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "prepare:learner": "node scripts/copy-learner.mjs",
    "dev": "npm run prepare:learner && vite",
    "build": "npm run prepare:learner && vite build",
    "test:sync": "node --test tests/sync.test.mjs",
    "test:backend": "npm --prefix backend test",
    "test": "npm run test:sync && npm run test:backend",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "@cloudbase/js-sdk": "3.6.3"
  },
  "devDependencies": {
    "vite": "8.1.5"
  }
}
